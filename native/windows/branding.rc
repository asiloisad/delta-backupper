#include <winresrc.h>

1 ICON "@@DELTA_ICON@@"

1 VERSIONINFO
FILEVERSION @@DELTA_NUMERIC_VERSION@@
PRODUCTVERSION @@DELTA_NUMERIC_VERSION@@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Delta Backupper contributors\0"
      VALUE "FileDescription", "Delta Backupper snapshot helper\0"
      VALUE "FileVersion", "@@DELTA_VERSION@@\0"
      VALUE "InternalName", "delta-vss\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 Delta Backupper contributors\0"
      VALUE "OriginalFilename", "delta-vss.exe\0"
      VALUE "ProductName", "Delta Backupper\0"
      VALUE "ProductVersion", "@@DELTA_VERSION@@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
