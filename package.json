{
  "name": "delta-backupper",
  "version": "0.0.0-stage0",
  "description": "Create and restore file backups with transparent ZIP archives.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": ".dev/build/main.cjs",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "prestart": "node script/build.mjs",
    "start": "electron --no-sandbox --enable-logging . -f --dev",
    "setup:runtime": "node script/setup-runtime.mjs",
    "notices": "node script/notices.mjs",
    "build": "node script/build.mjs",
    "check": "tsc --noEmit",
    "test": "node script/run-tests.mjs",
    "package": "node script/package.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.24.0",
    "stream-json": "3.8.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "app-builder-lib": "26.18.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "resedit": "1.7.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
